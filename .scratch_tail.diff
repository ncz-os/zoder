+/// One reviewer's chunk plan: its caps, the prepared diff, and the prompts.
+#[derive(Clone)]
+struct ReviewPlan {
+    caps: crate::review_diff::ReviewCaps,
+    window_tokens: Option<u64>,
+    prepared: crate::review_diff::PreparedDiff,
+    users: Vec<String>,
+    chunking: serde_json::Value,
+}
+
+fn single_review_budget(
+    window_tokens: Option<u64>,
+    reserved_tokens: u32,
+    max_diff_bytes: usize,
+    chunk_cap_bytes: usize,
+) -> usize {
+    match window_tokens {
+        None => chunk_cap_bytes,
+        Some(window) => ((window
+            .saturating_sub(u64::from(reserved_tokens))
+            .saturating_mul(zoder_core::context_opt::BYTES_PER_TOKEN)
+            .min(usize::MAX as u64)) as usize)
+            .min(max_diff_bytes),
+    }
+}
+
+fn review_plan_matches(
+    plan_caps: crate::review_diff::ReviewCaps,
+    plan_window_tokens: Option<u64>,
+    caps: crate::review_diff::ReviewCaps,
+    window_tokens: Option<u64>,
+) -> bool {
+    plan_caps == caps && plan_window_tokens == window_tokens
+}
+
+/// Build the per-chunk reviewer prompts for a prepared diff.
+///
+/// `preamble` is the per-review context block (the task under review, the
+/// validation output). It is placed AFTER the cache-stable head, never
+/// before it: a prefix cache is keyed on the leading bytes, so anything that
+/// varies per review and sits in front of the head breaks the cache on every
+/// review and re-bills the whole head.
+fn build_review_users(
+    label: &str,
+    focus_txt: &str,
+    preamble: &str,
+    prepared: &crate::review_diff::PreparedDiff,
+    context_budget: usize,
+    context_for: &dyn Fn(&str, usize) -> String,
+) -> Vec<String> {
+    // A chunked review is a fan of independent calls over one diff, so it is
+    // the one place a prompt cache pays for itself many times over — if the
+    // leading bytes are identical on every call. `review_baton` hoists the
+    // constant head (system prompt aside, which travels in the `system` slot,
+    // plus the diff map, the partial-diff notice and the focus line) and any
+    // byte-identical per-chunk context header into one shared prefix, then
+    // appends the preamble, the part banner and the chunk. Before it, the diff
+    // map was repeated on all 16 calls of a 16-chunk review.
+    let chunks: Vec<String> = prepared.chunks.clone();
+    let map = prepared.diff_map.clone().unwrap_or_default();
+    let wrapped_map = if map.is_empty() {
+        String::new()
+    } else {
+        format!(
+            "Diff map (deterministic; covers ALL chunks of this diff). Before reporting a symbol \
+as undefined, redefined, or recursively calling a missing function, check it against this map:\n{map}"
+        )
+    };
+    let rendered = crate::review_baton::render_review(
+        // The reviewer system prompt is passed separately to `complete_once`;
+        // the baton only needs the *body* prefix it must keep byte-stable.
+        "",
+        &wrapped_map,
+        label,
+        focus_txt,
+        &chunks,
+        preamble,
+        &|idx| {
+            context_for(
+                chunks.get(idx).map(String::as_str).unwrap_or_default(),
+                context_budget,
+            )
+        },
+    );
+    rendered.prompts
+}
