/target
**/target
# Local data, benchmarks, and anything containing tokens/spend/proofs — never commit.
/data
*.parquet
*.log
.DS_Store
tools/data/
# Python caches
**/__pycache__/
*.pyc
# Generated catalog snapshots (rebuilt daily by catalog/refresh.sh)
catalog/model_index*.json
catalog/model_index*.csv
# GitOps: never commit rendered secrets or per-host secret material; build output
gitops/secrets/
/dist
gitops/dist/
# Argonas / merge artifacts — never commit
.merge-out/
.zeroclaw-src/

# intermediate fetcher outputs (regenerated by scripts/fetch-*.py)
bench/raw/

# goose source clone (built by package.sh, never tracked)
.goose-src/
.gate.sh
# Per-worktree agent session logs (regenerated by the assistant on every run;
# never commit — they contain local CI/PAT noise that pollutes diffs and
# never belongs in the repo).
/memory

# Local scratch roots for the test harness. `/t` is where the test
# suite writes its per-run session dirs when TMPDIR points inside the
# workspace; `.tmpbuild/` holds the flake-evidence harness (stress
# scripts, base/fixed test binaries, load generators) and the scratch
# worktree used to measure the pre-fix failure rate. Both are local
# development artifacts — never commit them.
/t
/.tmpbuild/
